# yakvc-server as a hardened systemd service, without Docker. Install the
# binary to /usr/local/bin and config.toml to /etc/yakvc (see README.md).
# The server creates its keys in /var/lib/yakvc on first start.
[Unit]
Description=Yak VC rendezvous server and relay
Wants=network-online.target
After=network-online.target

[Service]
# The server reports READY=1 once it is listening.
Type=notify
ExecStart=/usr/local/bin/yakvc-server run --config /etc/yakvc/config.toml
Restart=on-failure

# A throwaway user, which may bind ports 80 and 443 and write only
# /var/lib/yakvc (the keys and the ACME cache), readable by it alone.
DynamicUser=yes
StateDirectory=yakvc
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Netlink: iroh watches the network interfaces for changes.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
