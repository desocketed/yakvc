{
	"schemaVersion": 1,
	"id": "yakvc",
	"version": "${version}",
	"name": "Yak VC",
	"description": "Peer-to-peer proximity voice chat for online-mode servers. No server mod required.",
	"license": "MIT OR Apache-2.0",
	"icon": "assets/yakvc/icon.png",
	"contact": {
		"homepage": "https://github.com/desocketed/yakvc",
		"sources": "https://github.com/desocketed/yakvc",
		"issues": "https://github.com/desocketed/yakvc/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.desocketed.yakvc.YakVcClient"
		],
		"modmenu": [
			"io.github.desocketed.yakvc.ui.ModMenuEntry"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
